# Copy to .env and set only values required by your deployment.
# Never commit .env, credentials, API-client YAML, or private keys.

# Case and evidence paths
CASE_ROOT=
CASE_INVESTIGATION_DIR=
CASE_EVIDENCE_ROOT=

# Shared analysis runtime
AI_SKILLS_ANALYST_AGENT_ENABLED=
AI_SKILLS_ANALYST_AGENT_CONFIG_FILE=
AI_SKILLS_ANALYST_AGENT_TRANSPORT=
AI_SKILLS_ANALYST_AGENT_CONFIG_SOURCE=
AI_SKILLS_ANALYST_AGENT_CODEX_CONFIG=
AI_SKILLS_ANALYST_AGENT_CODEX_PROFILE=
AI_SKILLS_ANALYST_AGENT_PROVIDER=
AI_SKILLS_ANALYST_AGENT_MODEL=
AI_SKILLS_ANALYST_AGENT_REASONING_EFFORT=
AI_SKILLS_ANALYST_AGENT_TIMEOUT_SECONDS=
AI_SKILLS_ANALYST_AGENT_MAX_RETRIES=
AI_SKILLS_ANALYST_AGENT_MAX_CONCURRENCY=
AI_SKILLS_DETECTRAPTOR_QUERY_TIMEOUT_SECONDS=
OPENAI_API_KEY=
OPENAI_BASE_URL=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_AUTH_MODE=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=

# Operational overrides are optional; empty values preserve config.toml.
# Local Velociraptor
VELO_BIN=
VELO_LOCAL_VERSION_TAG=
VELO_LOCAL_API_USER=
VELO_LOCAL_API_PASSWORD=
VELO_LOCAL_PORTS=
VELO_LOCAL_API_CLIENT=
VELO_LOCAL_ORG_ID=
VELO_LOCAL_CONFIG_ROOT=
# Retain verbose DEBUG lines. Sanitized server text can contain sensitive evidence.
VELO_PROGRESS_FILE_DEBUG=
VELO_MAPPED_CLIENT_WORKSPACE=

# Site-owned policy overlays
VELO_ARTIFACT_REFERENCE_PATHS=
VELO_DETECTION_SCENARIO_PATHS=
VELO_HUNT_FILTER_PATHS=
VELO_ENGAGEMENT_CODE_PATTERN=

# Remote Velociraptor access
VELO_REMOTE_SSH_USER=
VELO_REMOTE_SSH_KEY=
VELO_REMOTE_RUN_AS=
VELO_REMOTE_BIN=
VELO_REMOTE_SERVER_CONFIG_PATH=
VELO_REMOTE_CLIENT_CONFIG_PATH=
VELO_REMOTE_API_USER=
# Use investigation only where the server supports investigator,api.
VELO_REMOTE_API_ROLE_PROFILE=
VELO_REMOTE_API_CONFIG_PATH=

# Optional reusable Autoruns database override
VELO_AUTORUNS_GOLDEN_DB=
VELO_AUTORUNS_GOLDEN_TOOL=
VELO_AUTORUNS_GOLDEN_VERSION=

# Optional connection and mapping transport overrides
VELO_GRPC_MAX_MESSAGE_BYTES=
VELO_MAPPED_CLIENT_STARTUP_TIMEOUT_SECONDS=
VELO_MAPPED_CLIENT_READY_TIMEOUT_SECONDS=
VRAPTOR_ZIP_PASSWORD_FILE=
