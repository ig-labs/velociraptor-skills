LET MaxHostnames = HOST_LIMIT
LET GoldenRules <= parse_json_array(data=gunzip(string=base64decode(string=AutorunsTestReviewGzip)))
LET Ready <= len(list=GoldenRules) = RULE_COUNT
SELECT "ready" AS _Review, len(list=GoldenRules) AS Rules, Ready FROM scope()
LET Counts <= dict(SourceRows=0, EligibleRows=0, MatchedRows=0, ResidualRows=0, GroupCount=0, MatchingEvaluations=0, CacheBypasses=0, CacheErrors=0, CacheOverflowUsed=FALSE)
LET Bump(Name) = set(item=Counts, field=Name, value=get(item=Counts, field=Name) + 1)
LET NormalizeText(Value) = lowcase(string=if(condition=Value, then=Value, else=""))
LET NormalizePath(Value) = regex_transform(source=NormalizeText(Value=Value), map=dict(
    `(?-i)%localappdata%`='''c:\users\user\appdata\local''',
    `(?-i)%appdata%`='''c:\users\user\appdata\roaming''',
    `(?-i)%userprofile%`='''c:\users\user''',
    `(?-i)c:\\\\users\\\\[^\\\\]+`='''c:\users\user''',
    `(?-i)c:\\\\documents and settings\\\\[^\\\\]+`='''c:\users\user''',
    `(?-i)s-1-5-21-(?:[0-9]+-){3}[0-9]+`='''sid''',
    `(?-i)%systemroot%`='''c:\windows''',
    `(?-i)%windir%`='''c:\windows''',
    `(?-i)^\\\\systemroot\\\\`='''c:\windows\'''
), key="autoruns-regex-review-lowercase-v1")
LET HostSamples <= dict()
LET SampleFor(Key) = get(item=if(condition=get(item=HostSamples, field=Key),
    then=HostSamples, else=set(item=HostSamples, field=Key, value=dict(Names=dict()))), field=Key)
LET KeepHost(State, Name) = if(
    condition=Name AND len(list=State.Names) < MaxHostnames AND NOT get(item=State.Names, field=Name),
    then=set(item=State, field="Names", value=set(item=State.Names, field=Name, value=TRUE)), else=State)
LET enabled_rows = SELECT
    if(condition=Category, then=Category, else="") AS Category,
    get(item=scope(), field="Image Path") AS ImagePath,
    get(item=scope(), field="Launch String") AS LaunchString,
    Signer, get(item=scope(), field="Fqdn") AS Fqdn
FROM SOURCE_QUERY
WHERE Ready AND Bump(Name="SourceRows")
    AND Enabled = "enabled" AND (ImagePath OR LaunchString)
    AND NOT ImagePath =~ '^File not found:' AND Bump(Name="EligibleRows")
LET normalized_rows = SELECT Category, NormalizePath(Value=ImagePath) AS ImagePath,
    NormalizePath(Value=LaunchString) AS LaunchString,
    NormalizeText(Value=Signer) AS Signer, NormalizeText(Value=Fqdn) AS Hostname
FROM enabled_rows
// Metrics have a separate bound; they never alter the category LRU allocation.
LET ReviewMetricCategories <= dict()
LET ReviewNewMetrics(Label) = dict(Category=Label, MatchedRows=0, ResidualRows=0,
    MatchedEvaluations=0, ResidualEvaluations=0, MatchedBypasses=0, ResidualBypasses=0)
LET ReviewMetricOverflow <= ReviewNewMetrics(Label=NULL)
LET ReviewMetrics(Key) = if(condition=get(item=ReviewMetricCategories, field=Key),
    then=get(item=ReviewMetricCategories, field=Key),
    else=if(condition=len(list=ReviewMetricCategories) < METRIC_MAX_CATEGORIES
            AND len(list=Key) <= METRIC_MAX_CATEGORY_BYTES,
        then=get(item=set(item=ReviewMetricCategories, field=Key,
            value=ReviewNewMetrics(Label=Category)), field=Key), else=ReviewMetricOverflow))
LET measured_rows = SELECT *, ReviewMetrics(Key=serialize(item=Category, format="json")) AS DecisionStats
FROM normalized_rows
LET ReviewMetricBump(Name) = set(item=DecisionStats, field=Name,
    value=get(item=DecisionStats, field=Name) + 1)
LET ReviewCountOutcome(Name) = set(item=Counts, field=Name,
    value=get(item=Counts, field=Name) + 1) AND set(item=DecisionStats, field=Name,
    value=get(item=DecisionStats, field=Name) + 1)
LET ReviewEvaluation(Value) = if(condition=Bump(Name="MatchingEvaluations")
    AND ReviewMetricBump(Name=if(condition=Value, then="MatchedEvaluations", else="ResidualEvaluations")), then=Value)
LET ReviewBypass(Value) = if(condition=Bump(Name="CacheBypasses")
    AND ReviewMetricBump(Name=if(condition=Value, then="MatchedBypasses", else="ResidualBypasses")), then=Value)
// Cache only the complete four-field decision; counters and hosts remain per occurrence.
LET ReviewFullMatch() = ReviewEvaluation(Value=any(items=GoldenRules,
    filter="rule=>Category =~ rule.Category AND ImagePath =~ rule.ImagePath AND LaunchString =~ rule.LaunchString AND Signer =~ rule.Signer"))
// Reserve at most 19 category LRUs; all further categories share one bounded LRU.
LET ReviewCategoryNames <= dict()
LET ReviewCategoryCache(CategoryKey) = if(condition=get(item=ReviewCategoryNames, field=CategoryKey),
    then=get(item=ReviewCategoryNames, field=CategoryKey),
    else=if(condition=len(list=ReviewCategoryNames) < CACHE_DEDICATED_CATEGORIES,
        then=get(item=set(item=ReviewCategoryNames, field=CategoryKey,
            value=format(format="autoruns-regex-review-category-%d", args=[len(list=ReviewCategoryNames)])), field=CategoryKey),
        else=if(condition=set(item=Counts, field="CacheOverflowUsed", value=TRUE),
            then="autoruns-regex-review-category-overflow")))
LET ReviewCachedMatch(Key) = if(condition=len(list=Key) <= CACHE_KEY_BYTES,
    then=cache(name=CACHE_NAME, key=Key,
        max_size=CACHE_ENTRIES, func=ReviewFullMatch()),
    else=ReviewBypass(Value=ReviewFullMatch()))
LET ReviewCheckedMatch(Value) = if(condition=typeof(v=Value) = "bool", then=Value,
    else=if(condition=Bump(Name="CacheErrors"), then=FALSE))
LET filtered_rows = SELECT * FROM measured_rows
WHERE if(condition=ReviewCheckedMatch(Value=MATCH_EXPRESSION),
    then=if(condition=ReviewCountOutcome(Name="MatchedRows"), then=FALSE),
    else=if(condition=ReviewCountOutcome(Name="ResidualRows"), then=TRUE))
LET keyed_rows = SELECT *, serialize(item=dict(Category=Category, ImagePath=ImagePath,
    LaunchString=LaunchString, Signer=Signer), format="json") AS StackKey FROM filtered_rows
LET stacks = SELECT Category, ImagePath, LaunchString, Signer, count() AS TotalRows,
    KeepHost(State=SampleFor(Key=StackKey), Name=Hostname) AS HostSample
FROM keyed_rows GROUP BY StackKey
SELECT "stack" AS _Review, Category, ImagePath, LaunchString, Signer, TotalRows,
    if(condition=HostSample.Names, then=items(item=HostSample.Names)._key, else=array()) AS ExampleHosts
FROM stacks WHERE Bump(Name="GroupCount")
SELECT "summary" AS _Review, Counts.SourceRows AS SourceRows, Counts.EligibleRows AS EligibleRows,
    Counts.MatchedRows AS MatchedRows, Counts.ResidualRows AS ResidualRows, Counts.GroupCount AS GroupCount,
    Counts.MatchingEvaluations AS MatchingEvaluations, Counts.CacheBypasses AS CacheBypasses, Counts.CacheErrors AS CacheErrors,
    len(list=ReviewCategoryNames) AS CacheCategories, Counts.CacheOverflowUsed AS CacheOverflowUsed,
    if(condition=len(list=ReviewMetricCategories), then=items(item=ReviewMetricCategories)._value,
        else=array()) AS CacheCategoryMetrics,
    ReviewMetricOverflow AS CacheCategoryMetricsOverflow
FROM scope()
