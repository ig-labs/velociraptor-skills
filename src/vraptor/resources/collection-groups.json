  "bundles": {
    "ir-standard-live": {
      "target_mode": "live",
      "purpose": "Standard Windows incident-response collection for a running endpoint.",
      "groups": [
        "signal-triage",
        "volatile-state",
        "execution-history",
        "identity-state",
        "persistence-state",
        "authentication-lateral",
        "script-execution",
        "defense-evasion"
      ]
    },
    "ir-standard-disk": {
      "target_mode": "mapped-disk",
      "purpose": "Standard Windows incident-response collection for a mapped dead disk, with volatile-only sources recorded as not applicable.",
      "groups": [
        "signal-triage",
        "volatile-state",
        "execution-history",
        "identity-state",
        "persistence-state",
        "authentication-lateral",
        "script-execution",
        "defense-evasion"
      ]
    }
  },
  "followups": {
    "account-changes": {
      "route": "bounded-timeline",
      "cost": "medium",
      "scope_gate": "time-bounds",
      "required_inputs": ["date-after", "date-before", "event-id-or-ioc-filter"],
      "reason": "Account and group-change claims require bounded security-event review and outcome validation."
    },
    "timeline": {
      "route": "collection-type:timeline",
      "cost": "high",
      "scope_gate": "time-bounds",
      "required_inputs": ["date-after-or-date-before"],
      "reason": "Full MFT and EVTX collection is intentionally time bounded."
    },
    "staging-exfiltration": {
      "route": "collection-type:exfiltration",
      "cost": "high",
      "scope_gate": "time-bounds",
      "required_inputs": ["date-after", "date-before", "path-or-ioc-filter"],
      "reason": "Large MFT, EVTX, SRUM, and Prefetch collection should follow a concrete staging or transfer hypothesis."
    },
    "remote-tool-sessions": {
      "route": "explicit-artifact",
      "cost": "medium",
      "scope_gate": "explicit-target",
      "required_inputs": ["tool-family-or-path", "time-window"],
      "reason": "Session-specific remote-management artifacts are useful only after a product or path lead exists."
    },
    "malware-deep": {
      "route": "explicit-artifact",
      "cost": "high",
      "scope_gate": "bounded-search-root",
      "required_inputs": ["path-hash-name-or-yara-rule", "bounded-search-root"],
      "reason": "BinaryHunter, FileFinder, and wide YARA searches are high-cost and question triggered."
    },
    "web-server": {
      "route": "explicit-artifact",
      "cost": "medium",
      "scope_gate": "explicit-target",
      "required_inputs": ["server-role", "log-or-web-root"],
      "reason": "Web-server evidence is role specific and should not run on every endpoint."
    },
    "domain-controller": {
      "route": "explicit-artifact",
      "cost": "high",
      "scope_gate": "time-bounds",
      "required_inputs": ["confirmed-domain-controller-role", "time-window"],
      "reason": "Directory-service and broad authentication collection is role specific and potentially high volume."
    }
  },
  "prohibited_baseline_artifacts": [
    "Windows.Registry.Hunter[all]",
    "Windows.NTFS.MFT",
    "Windows.EventLogs.EvtxHunter",
    "Windows.Search.BinaryHunter",
    "Windows.Search.FileFinder",
    "Generic.Detection.Yara.Glob"
  ]
}
