{
  "schema_version": 1,
  "policy_id": "public-ir-collection-groups",
  "target_modes": [
    "live",
    "mapped-disk"
  ],
  "requirements": [
    "core",
    "recommended",
    "optional"
  ],
  "cost_classes": [
    "low",
    "medium",
    "high"
  ],
  "scope_gates": [
    "none",
    "time-bounds",
    "bounded-search-root",
    "explicit-target"
