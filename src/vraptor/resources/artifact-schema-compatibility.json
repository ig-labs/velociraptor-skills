{
  "schema_version": 1,
  "contract_name": "velociraptor-windows-review-artifact-schemas",
  "description": "Minimum connected-server output semantics required by the Windows artifact review workflows. Each semantic alias group is satisfied when at least one listed field is present.",
  "artifacts": {
