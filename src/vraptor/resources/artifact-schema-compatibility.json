            "Path"
          ]
        },
        {
          "semantic": "user",
          "aliases": [
            "UserName",
            "User",
            "SID"
          ]
        },
        {
          "semantic": "execution_time",
          "aliases": [
            "Bam_time",
            "LastExecution",
            "ExecutionTime",
            "Timestamp"
          ]
        }
      ]
    },
