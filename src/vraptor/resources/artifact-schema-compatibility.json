      "description": "RDP authentication and session event review.",
      "semantic_alias_groups": [
        {
          "semantic": "event_time",
          "aliases": [
            "EventTime",
            "Timestamp"
          ]
        },
        {
          "semantic": "user",
          "aliases": [
            "UserName",
            "User",
            "AccountName",
            "TargetUserName"
          ]
        },
        {
          "semantic": "source_ip",
          "aliases": [
            "SourceIP",
            "SourceAddress",
            "IpAddress",
            "IPAddress"
          ]
        },
        {
          "semantic": "event_id",
          "aliases": [
            "EventID",
            "EventId"
          ]
        }
      ]
    },
    "Windows.EventLogs.ExplicitLogon": {
      "description": "Explicit credential-use event review.",
      "semantic_alias_groups": [
        {
          "semantic": "event_time",
          "aliases": [
            "EventTime",
            "Timestamp"
          ]
        },
        {
          "semantic": "target_account",
          "aliases": [
            "TargetUserName",
            "AccountName",
            "UserName",
            "User"
          ]
        },
        {
          "semantic": "target_server",
          "aliases": [
            "TargetServerName",
            "TargetServer",
            "ServerName"
          ]
        },
        {
          "semantic": "process",
          "aliases": [
            "ProcessName",
            "Process"
          ]
        },
        {
          "semantic": "event_id",
          "aliases": [
            "EventID",
            "EventId"
          ]
        }
      ]
    },
    "Windows.Forensics.Amcache": {
      "description": "Native Amcache parser output across File and InventoryApplicationFile source variants.",
      "semantic_alias_groups": [
        {
          "semantic": "file_path",
          "aliases": [
            "FullPath",
            "LowerCaseLongPath",
            "Path"
          ]
        },
        {
          "semantic": "file_hash",
          "aliases": [
            "SHA1",
            "FileId"
          ]
        },
        {
          "semantic": "timestamp",
          "aliases": [
